{
  "name": "cover-image",
  "version": "0.1.0",
  "description": "프론트매터의 thumbnail 을 글 맨 위 대표 이미지로 넣는 Quartz 플러그인",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "cover-image",
    "displayName": "Cover Image",
    "category": "transformer",
    "version": "0.1.0",
    "quartzVersion": ">=5.1.0",
    "dependencies": [],
    "defaultOrder": 5,
    "defaultEnabled": true,
    "defaultOptions": { "key": "thumbnail", "alt": "대표 이미지" }
  }
}
